# Server
APP_NAME=PlantGuard AI API
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:8501
MAX_UPLOAD_BYTES=10485760

# Model artifacts (paths are relative to the project root)
MODEL_PATH=model/plant_disease_model.keras
CLASS_MAPPING_PATH=model/class_mapping.json

# Must match the training pipeline
IMAGE_WIDTH=240
IMAGE_HEIGHT=240
COLOR_MODE=RGB
SCALE_MODE=none
# Optional comma-separated channels. Leave both blank unless training used dataset normalization.
NORMALIZATION_MEAN=
NORMALIZATION_STD=
LOW_CONFIDENCE_THRESHOLD=0.60

# Frontend
API_BASE_URL=http://localhost:8000
